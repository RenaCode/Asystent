ANTHROPIC_API_KEY=sk-ant-...
# Co najmniej 32 znaki, np. `openssl rand -hex 32`. Ten sam w Config.local.xcconfig apki.
APP_TOKEN=
MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — asystent głosowy: low (najmniejsze opóźnienie)
EFFORT=low
# 1–21333 (proxy nie streamuje; SDK odrzuca wyższe bez streamingu). Zła liczba = błąd startu.
MAX_TOKENS=16000
RATE_LIMIT_PER_MIN=30
PORT=8787
