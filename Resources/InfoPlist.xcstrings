{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "shouldTranslate": false
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejo adds events you ask for and reads event dates and titles to answer questions; those titles are sent to Claude (Anthropic)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejo dodaje wydarzenia, o które prosisz, i czyta daty oraz tytuły wydarzeń, by odpowiadać na pytania; tytuły trafiają do Claude (Anthropic)."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejo listens only while the microphone button is active, to turn your command into text."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejo słucha tylko wtedy, gdy przycisk mikrofonu jest aktywny, by zamienić polecenie na tekst."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejo creates reminders you dictate; the reminder text is sent to Claude (Anthropic)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejo tworzy dyktowane przypomnienia; ich treść trafia do Claude (Anthropic)."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your speech is transcribed on this iPhone when possible, otherwise by Apple's servers. The text (not the audio) is sent to Claude by Anthropic to answer you."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mowa jest rozpoznawana na tym iPhonie, gdy to możliwe, w przeciwnym razie przez serwery Apple. Tekst (nie nagranie) trafia do Claude firmy Anthropic, by przygotować odpowiedź."
          }
        }
      }
    }
  },
  "version": "1.0"
}