{
  "sourceLanguage": "en",
  "strings": {
    "%@ error %lld: %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — błąd %2$lld: %3$@"
          }
        }
      }
    },
    "%@ is temporarily unavailable or overloaded (%lld). Please try again in a moment.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa %1$@ jest chwilowo niedostępna albo przeciążona (%2$lld). Spróbuj ponownie za chwilę."
          }
        }
      }
    },
    "**%@:** %@": {
      "shouldTranslate": false
    },
    "Add your Anthropic API key in Settings.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj swój klucz API Anthropic w Ustawieniach."
          }
        }
      }
    },
    "Allow sending your requests to Anthropic first (Settings → Privacy).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zgódź się na wysyłanie zapytań do Anthropic (Ustawienia → Prywatność)."
          }
        }
      }
    },
    "Answers are generated by AI (Claude by Anthropic) and may be inaccurate.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi tworzy AI (Claude firmy Anthropic) i mogą zawierać błędy."
          }
        }
      }
    },
    "Answers are generated by AI (Claude by Anthropic) and may be inaccurate. Touch and hold an answer to report it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi generuje AI (Claude firmy Anthropic) i mogą być nieścisłe. Przytrzymaj odpowiedź, by ją zgłosić."
          }
        }
      }
    },
    "Anthropic API key": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz API Anthropic"
          }
        }
      }
    },
    "Anthropic Privacy Policy": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polityka prywatności Anthropic"
          }
        }
      }
    },
    "Anthropic rejected the API key. Check or replace it in Settings.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic odrzucił klucz API. Sprawdź go albo wklej nowy w Ustawieniach."
          }
        }
      }
    },
    "Ask": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj"
          }
        }
      }
    },
    "Ask Hejo": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj Hejo"
          }
        }
      }
    },
    "Backend": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie"
          }
        }
      }
    },
    "Before you start": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim zaczniesz"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluj"
          }
        }
      }
    },
    "Current time": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualny czas"
          }
        }
      }
    },
    "Dates, times and titles of events from all calendars on this iPhone when a request needs your calendar. The AI chooses the date range (up to 20 events).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daty, godziny i tytuły wydarzeń ze wszystkich kalendarzy na tym iPhonie, gdy prośba wymaga sprawdzenia kalendarza. Zakres dat wybiera AI (do 20 wydarzeń)."
          }
        }
      }
    },
    "Directly from this iPhone to Anthropic (USA), under your own agreement with Anthropic and billed to your API key. RenaCode does not receive or store this data.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosto z tego iPhone’a do Anthropic (USA), na podstawie Twojej umowy z Anthropic i na koszt Twojego klucza API. RenaCode nie otrzymuje ani nie przechowuje tych danych."
          }
        }
      }
    },
    "Done.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe."
          }
        }
      }
    },
    "Hejo": {
      "shouldTranslate": false
    },
    "Hejo (AI)": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejo (AI)"
          }
        }
      }
    },
    "Hejo is an AI assistant. Answers are generated by Claude, an AI model by Anthropic, and may be inaccurate.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejo to asystent oparty na sztucznej inteligencji. Odpowiedzi tworzy Claude, model AI firmy Anthropic, i mogą zawierać błędy."
          }
        }
      }
    },
    "Hejo: reported answer": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hejo: zgłoszona odpowiedź"
          }
        }
      }
    },
    "I agree": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgadzam się"
          }
        }
      }
    },
    "Key saved — paste to replace": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz zapisany — wklej nowy, by zastąpić"
          }
        }
      }
    },
    "Listening…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słucham…"
          }
        }
      }
    },
    "Microphone or speech recognition permission is missing.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zgody na mikrofon lub rozpoznawanie mowy."
          }
        }
      }
    },
    "Names of HomeKit accessories, rooms and scenes.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy urządzeń, pomieszczeń i scen HomeKit."
          }
        }
      }
    },
    "Names of Shortcuts you ask to run and the text passed to them.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy Skrótów, które każesz uruchomić, i przekazywany im tekst."
          }
        }
      }
    },
    "No": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie"
          }
        }
      }
    },
    "Not allowed": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zgody"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie teraz"
          }
        }
      }
    },
    "Opens Hejo and starts listening right away.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Hejo i od razu zaczyna słuchać."
          }
        }
      }
    },
    "Own API key": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własny klucz API"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatność"
          }
        }
      }
    },
    "Privacy Policy": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polityka prywatności"
          }
        }
      }
    },
    "Proxy is not configured (PROXY_URL and APP_TOKEN in Config.local.xcconfig).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy nie jest skonfigurowane (PROXY_URL i APP_TOKEN w Config.local.xcconfig)."
          }
        }
      }
    },
    "Remove key": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń klucz"
          }
        }
      }
    },
    "Report answer": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoś odpowiedź"
          }
        }
      }
    },
    "Reported Hejo answer:": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłaszana odpowiedź Hejo:"
          }
        }
      }
    },
    "Requests go straight from this iPhone to api.anthropic.com and are billed to your key.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytania idą prosto z tego iPhone’a do api.anthropic.com i są rozliczane na Twój klucz."
          }
        }
      }
    },
    "Requests go to the proxy set in Config.local.xcconfig at build time.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytania idą do proxy ustawionego w Config.local.xcconfig podczas budowania."
          }
        }
      }
    },
    "Reset": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od nowa"
          }
        }
      }
    },
    "Review and allow…": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj i zezwól…"
          }
        }
      }
    },
    "Run the shortcut “%@”?": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchomić skrót „%@”?"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz"
          }
        }
      }
    },
    "Self-hosted proxy": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własne proxy"
          }
        }
      }
    },
    "Send": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij"
          }
        }
      }
    },
    "Sending to Anthropic": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłanie do Anthropic"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia"
          }
        }
      }
    },
    "Sorry, I can't help with that.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepraszam, w tym nie mogę pomóc."
          }
        }
      }
    },
    "Sorry, I couldn't finish this task.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepraszam, nie udało mi się dokończyć tego zadania."
          }
        }
      }
    },
    "Sorry, my answer got cut off. Please try again.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepraszam, moja odpowiedź została ucięta. Spróbuj jeszcze raz."
          }
        }
      }
    },
    "Speech is transcribed by Apple: on this iPhone when possible, otherwise on Apple's servers.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mowę rozpoznaje Apple: na tym iPhonie, gdy to możliwe, w przeciwnym razie na serwerach Apple."
          }
        }
      }
    },
    "Speech recognition is unavailable for this language.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy w tym języku jest niedostępne."
          }
        }
      }
    },
    "Start listening": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij słuchać"
          }
        }
      }
    },
    "Start talking to Hejo.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij mówić do Hejo."
          }
        }
      }
    },
    "Stop listening": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestań słuchać"
          }
        }
      }
    },
    "Stored only in this device's Keychain. You can create a key in the Anthropic Console; its use is subject to Anthropic's terms.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywany tylko w pęku kluczy tego urządzenia. Klucz utworzysz w konsoli Anthropic; korzystanie z niego podlega warunkom Anthropic."
          }
        }
      }
    },
    "The conversation so far: your earlier requests, the AI’s answers and the results of actions (for example calendar events read). It is sent again with every request until you tap Reset or restart the app.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotychczasowa rozmowa: Twoje wcześniejsze prośby, odpowiedzi AI i wyniki akcji (np. odczytane wydarzenia z kalendarza). Jest wysyłana ponownie z każdym zapytaniem, dopóki nie stukniesz „Od nowa” albo nie uruchomisz aplikacji ponownie."
          }
        }
      }
    },
    "The current date and time, your time zone, and this iPhone’s language and region.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżąca data i godzina, Twoja strefa czasowa oraz język i region tego iPhone’a."
          }
        }
      }
    },
    "The model returned an invalid response.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model zwrócił niepoprawną odpowiedź."
          }
        }
      }
    },
    "The proxy rejected the app token (APP_TOKEN in Config.local.xcconfig).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy odrzuciło token aplikacji (APP_TOKEN w Config.local.xcconfig)."
          }
        }
      }
    },
    "The text and due date of reminders you create.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treść i termin tworzonych przypomnień."
          }
        }
      }
    },
    "The text of what you say (transcribed speech), not the audio.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst Twojej wypowiedzi (rozpoznana mowa), bez nagrania dźwięku."
          }
        }
      }
    },
    "This API key has no permission for this request. Check the key's workspace and limits in the Anthropic Console.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten klucz API nie ma uprawnień do tego zapytania. Sprawdź workspace i limity klucza w konsoli Anthropic."
          }
        }
      }
    },
    "Title, start and end time, and place of events you ask to create.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuł, godzina początku i końca oraz miejsce wydarzeń, które każesz utworzyć."
          }
        }
      }
    },
    "To the self-hosted proxy set in this build, which forwards it to Anthropic (USA).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Twojego proxy ustawionego w tym buildzie, które przekazuje je do Anthropic (USA)."
          }
        }
      }
    },
    "Too many requests. Wait a moment and try again.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo zapytań. Odczekaj chwilę i spróbuj ponownie."
          }
        }
      }
    },
    "Type a command": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz polecenie"
          }
        }
      }
    },
    "Unexpected model stop reason: %@": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieoczekiwany powód zakończenia odpowiedzi modelu: %@"
          }
        }
      }
    },
    "What is sent": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jest wysyłane"
          }
        }
      }
    },
    "What is wrong with it:": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jest nie tak:"
          }
        }
      }
    },
    "Where it goes": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokąd trafia"
          }
        }
      }
    },
    "Withdraw consent": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycofaj zgodę"
          }
        }
      }
    },
    "Yes": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak"
          }
        }
      }
    },
    "You": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty"
          }
        }
      }
    },
    "You can withdraw consent at any time in Settings → Privacy. Without consent nothing is sent.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgodę możesz w każdej chwili wycofać w Ustawieniach → Prywatność. Bez zgody nic nie jest wysyłane."
          }
        }
      }
    },
    "Your Anthropic credit balance is too low. Add credits in the Anthropic Console.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało środków na koncie Anthropic. Doładuj je w konsoli Anthropic."
          }
        }
      }
    },
    "sk-ant-…": {
      "shouldTranslate": false
    }
  },
  "version": "1.0"
}